 "html": "\n<div class=\"print-format\" style=\"padding: 20px;\">\n\t<div style=\"display:flex; justify-content:space-between; align-items:flex-start;\">\n\t\t<div>\n\t\t\t<h2>{{ doc.get(\"company\") or \"\" }}</h2>\n\t\t\t<h3>{{ _(\"Delivery Sheet\") }} - {{ doc.delivery_sheet_no }}</h3>\n\t\t\t<p>{{ _(\"Date\") }}: {{ frappe.utils.format_date(doc.creation) }}</p>\n\t\t</div>\n\t\t<div style=\"text-align:center;\">\n\t\t\t<img src=\"{{ qr_data_uri(doc.delivery_sheet_no) }}\" style=\"width:100px; height:100px;\">\n\t\t</div>\n\t</div>\n\n\t<table class=\"print-heading-table\" style=\"width:100%; margin-top: 15px;\">\n\t\t<tr>\n\t\t\t<td><b>{{ _(\"Recipient Party\") }}:</b> {{ doc.recipient_party or \"\" }}</td>\n\t\t\t<td><b>{{ _(\"Delivery Method\") }}:</b> {{ doc.delivery_method or \"\" }}</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><b>{{ _(\"Courier\") }}:</b> {{ doc.courier_name or \"\" }}</td>\n\t\t\t<td><b>{{ _(\"Address\") }}:</b> {{ doc.delivery_address or \"\" }}</td>\n\t\t</tr>\n\t</table>\n\n\t<table class=\"table table-bordered\" style=\"width:100%; margin-top: 15px;\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th>{{ _(\"Reference No\") }}</th>\n\t\t\t\t<th>{{ _(\"Subject\") }}</th>\n\t\t\t\t<th>{{ _(\"Attachments\") }}</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{% for row in doc.items %}\n\t\t\t<tr>\n\t\t\t\t<td>{{ row.correspondence }}</td>\n\t\t\t\t<td>{{ row.subject or \"\" }}</td>\n\t\t\t\t<td>{{ row.attachment_count or 0 }}</td>\n\t\t\t</tr>\n\t\t\t{% endfor %}\n\t\t</tbody>\n\t</table>\n\n\t<table style=\"width:100%; margin-top: 60px;\">\n\t\t<tr>\n\t\t\t<td style=\"width:50%; text-align:center; border-top: 1px solid #000; padding-top: 5px;\">\n\t\t\t\t{{ _(\"Delivered By (Courier Signature)\") }}\n\t\t\t</td>\n\t\t\t<td style=\"width:50%; text-align:center; border-top: 1px solid #000; padding-top: 5px;\">\n\t\t\t\t{{ _(\"Received By (Party Signature)\") }}\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n</div>\n",
